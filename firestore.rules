rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        request.auth.token.email == "yogeshtiwari0620@gmail.com";
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == "user" &&
        request.resource.data.uid == uid;
      allow update, delete: if isOwner();
    }

    match /subscriptions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());

      // A new account may create only its initial 30-day trial.
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        ((request.resource.data.status == "trial" &&
          request.resource.data.expiryAt <= request.time + duration.value(31, "d")) ||
         request.resource.data.status == "pending");

      // Only the owner can approve, extend, reject, or disable subscriptions.
      allow update, delete: if isOwner();
    }

    match /paymentRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isOwner();
    }
  }
}